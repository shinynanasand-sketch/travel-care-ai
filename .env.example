# Database
DATABASE_URL="postgresql://USER:PASS@HOST:5432/DB"
DIRECT_URL="postgresql://USER:PASS@HOST:5432/DB"

# Google Gemini AI (aistudio.google.com)
GEMINI_API_KEY=""

# 공공데이터포털 통합 API 키
# Decoding 키(암호화되지 않은 원문) 권장.
# Encoding 키(%2F 등)를 넣어도 앱이 한 번 decode 후 사용합니다.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 적용 범위: TourAPI(KorService2), 심평원 병원정보(hospInfoServicev2),
#           심평원 약국정보(pharmacyInfoService), 응급·무장애·웰니스 등
# 주의: 「병원정보서비스」「약국정보서비스」도 각각 활용신청 필요
# 발급: data.go.kr → 마이페이지 → 인증키 발급현황 → Decoding 키 복사
PUBLIC_DATA_API_KEY=""

# ❌ 아래 변수들은 PUBLIC_DATA_API_KEY로 통합됨
#    (2026-07-08 변경)
# TOUR_API_KEY=""
# HIRA_API_KEY=""
# NMC_API_KEY=""

# 한국관광공사 TourAPI Base URL (KorService2, 2026-07-08 전환)
TOUR_API_BASE="https://apis.data.go.kr/B551011/KorService2"

# mock 강제 사용 (API 키 없이 개발 시 true 권장)
USE_MOCK_DATA="true"

# 카카오 지도 (JS SDK) + Local 검색 (병원/약국 폴백)
NEXT_PUBLIC_KAKAO_MAP_KEY=""
KAKAO_REST_API_KEY=""

# 개발: HIRA 실패·카카오 폴백 배너 표시 (local 또는 Vercel에서 true)
# production 데모에서는 false 권장
NEXT_PUBLIC_SHOW_MEDICAL_DIAGNOSTICS="true"

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Firebase FCM (보호자 알림)
# Console → Project settings → Service accounts → Generate new private key
# private_key는 한 줄로 넣고 \\n 이스케이프 유지
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""
# 클라이언트 SDK용(웹 토큰 발급 시). 서버 Admin과 별개
NEXT_PUBLIC_FIREBASE_CONFIG='{}'
# 또는 개별 변수로 설정 (CONFIG JSON과 병행 가능)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Firebase Console → Cloud Messaging → Web Push certificates → Key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# Auth
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
